TRACKER_DOMAIN=mail.example.com
PUBLIC_URL=https://mail.example.com
POSTGRES_PASSWORD=replace-with-long-random-value
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
INSTANCE_SECRET=replace-with-base64-encoded-32-byte-key
OWNER_EMAIL=you@example.com
GOOGLE_CLIENT_ID=your-web-oauth-client.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-web-oauth-secret
GOOGLE_ADDON_CLIENT_ID=your-apps-script-oauth-client.apps.googleusercontent.com

# Optional private hosted document storage (Raildrop Go SDK / Railway bucket).
RAILDROP_BUCKET=
RAILDROP_ENDPOINT=
RAILDROP_REGION=auto
RAILDROP_ACCESS_KEY_ID=
RAILDROP_SECRET_ACCESS_KEY=
RAILDROP_FORCE_PATH_STYLE=false
# Optional signed conversion webhook. Use a dedicated random secret.
CONVERSION_WEBHOOK_SECRET=
